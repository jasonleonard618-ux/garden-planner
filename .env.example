# Optional. Without these the app saves plans in the browser only and feedback/usage tracking are off.
# Create a free Supabase project, run supabase/schema.sql in its SQL editor, then copy these from
# Project settings > API. The anon key is safe to expose in the browser; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Invite-only pilot: comma-separated codes. Leave empty to open the site to everyone.
INVITE_CODES=
# Set to 1 once Google sign-in is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGNIN=
